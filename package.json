{
  "name": "transactions",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm run format:check && npm test && npm run build",
    "format": "prettier --write \"*.js\" \"transactions/*.js\" \"ui/*.js\" \"scripts/*.mjs\" \"tests/*.js\" README.md",
    "format:check": "prettier --check \"*.js\" \"transactions/*.js\" \"ui/*.js\" \"scripts/*.mjs\" \"tests/*.js\" README.md"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.9"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
