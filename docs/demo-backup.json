   "id": "demo-trip",
   "name": "Weekend in Lantern Bay",
   "start": "2026-08-15",
   "end": "2026-08-18",
   "color": "#2F6B8F",
   "story": "This is a fictional weekend in Lantern Bay. We stayed at the guesthouse and took the ferry. Routine bills and pet supplies happened during the same dates but were not part of the trip."
  }
